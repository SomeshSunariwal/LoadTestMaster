{
  "name": "loadmaster",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LoadMaster — Electrobun API load testing desktop application",
  "scripts": {
    "prepare:desktop": "electrobun prepare",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "bun src/backend/server.ts",
    "build:view": "vite build",
    "build:desktop-view": "vite build --mode desktop",
    "build": "npm run prepare:desktop && npm run typecheck && npm run build:desktop-view && node scripts/package.mjs",
    "dev:desktop": "npm run prepare:desktop && npm run build:desktop-view && electrobun dev",
    "start": "electrobun run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts *.json *.ts *.md",
    "format:check": "prettier --check src tests scripts *.json *.ts *.md",
    "test": "bun test",
    "check": "npm run typecheck && npm test && npm run build:view"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^2.3.0",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.14.5",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bun": "^1.4.3",
    "electrobun": "^2.0.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
